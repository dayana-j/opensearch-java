<mxfile host="app.diagrams.net">
  <diagram name="How gRPC Works" id="how-grpc-works">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="&lt;font size=&quot;5&quot;&gt;&lt;b&gt;How gRPC Works&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="700" y="20" width="200" height="40" as="geometry" />
        </mxCell>

        <!-- ═══ TOP SECTION: The Proto File (Contract) ═══ -->
        <mxCell id="proto-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=5;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="500" y="70" width="600" height="160" as="geometry" />
        </mxCell>
        <mxCell id="proto-title" value="&lt;b&gt;① Define the Contract (.proto file)&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="650" y="75" width="300" height="25" as="geometry" />
        </mxCell>
        <mxCell id="proto-code" value="&lt;font face=&quot;Courier New&quot; size=&quot;1&quot;&gt;// document_service.proto&lt;br&gt;&lt;br&gt;service DocumentService {&lt;br&gt;  rpc Bulk (BulkRequest) returns (BulkResponse) {}&lt;br&gt;}&lt;br&gt;&lt;br&gt;message BulkRequest {&lt;br&gt;  string index = 1;&lt;br&gt;  repeated BulkRequestBody bulk_request_body = 2;&lt;br&gt;}&lt;br&gt;&lt;br&gt;message BulkResponse {&lt;br&gt;  int64 took = 1;&lt;br&gt;  bool errors = 2;&lt;br&gt;  repeated Item items = 3;&lt;br&gt;}&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#999;align=left;spacingLeft=10;verticalAlign=top;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="520" y="100" width="280" height="120" as="geometry" />
        </mxCell>
        <mxCell id="proto-desc" value="&lt;b&gt;Protocol Buffers&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Defines services (methods)&lt;br&gt;• Defines messages (data types)&lt;br&gt;• Fields use integer tags (not strings)&lt;br&gt;• Compiled → generates client &amp; server code&lt;br&gt;• Both sides agree on the format" style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="820" y="100" width="260" height="120" as="geometry" />
        </mxCell>

        <!-- Arrow: proto generates code for both sides -->
        <mxCell id="gen-left" value="&lt;font color=&quot;#666&quot;&gt;generates&lt;br&gt;client code&lt;/font&gt;" style="endArrow=block;endSize=10;endFill=1;html=1;strokeWidth=1;strokeColor=#666;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="650" y="230" as="sourcePoint" />
            <mxPoint x="250" y="310" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="gen-right" value="&lt;font color=&quot;#666&quot;&gt;generates&lt;br&gt;server code&lt;/font&gt;" style="endArrow=block;endSize=10;endFill=1;html=1;strokeWidth=1;strokeColor=#666;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="950" y="230" as="sourcePoint" />
            <mxPoint x="1350" y="310" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- ═══ LEFT: Client ═══ -->
        <mxCell id="client-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="300" width="380" height="280" as="geometry" />
        </mxCell>
        <mxCell id="client-title" value="&lt;font size=&quot;3&quot;&gt;&lt;b&gt;② Client (Python / Java / Go / etc.)&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="100" y="310" width="300" height="25" as="geometry" />
        </mxCell>

        <mxCell id="client-app" value="&lt;b&gt;Application Code&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; size=&quot;1&quot;&gt;stub.Bulk(request)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="100" y="345" width="300" height="40" as="geometry" />
        </mxCell>

        <mxCell id="client-serial" value="&lt;b&gt;Serialize&lt;/b&gt;&lt;br&gt;Object → Protobuf binary bytes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="100" y="400" width="300" height="40" as="geometry" />
        </mxCell>

        <mxCell id="client-http2" value="&lt;b&gt;gRPC Framework&lt;/b&gt;&lt;br&gt;Sends over HTTP/2 (persistent, multiplexed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="100" y="455" width="300" height="40" as="geometry" />
        </mxCell>

        <mxCell id="client-deser" value="&lt;b&gt;Deserialize Response&lt;/b&gt;&lt;br&gt;Protobuf binary → Object" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="100" y="510" width="300" height="40" as="geometry" />
        </mxCell>

        <!-- Client internal arrows -->
        <mxCell id="ca1" value="" style="endArrow=block;endSize=8;endFill=1;html=1;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="250" y="385" as="sourcePoint" /><mxPoint x="250" y="400" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ca2" value="" style="endArrow=block;endSize=8;endFill=1;html=1;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="250" y="440" as="sourcePoint" /><mxPoint x="250" y="455" as="targetPoint" /></mxGeometry></mxCell>

        <!-- ═══ RIGHT: Server ═══ -->
        <mxCell id="server-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1160" y="300" width="380" height="280" as="geometry" />
        </mxCell>
        <mxCell id="server-title" value="&lt;font size=&quot;3&quot;&gt;&lt;b&gt;③ Server (OpenSearch :9400)&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1220" y="310" width="260" height="25" as="geometry" />
        </mxCell>

        <mxCell id="server-recv" value="&lt;b&gt;Receive &amp; Deserialize&lt;/b&gt;&lt;br&gt;Protobuf binary → Server objects" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1200" y="345" width="300" height="40" as="geometry" />
        </mxCell>

        <mxCell id="server-exec" value="&lt;b&gt;Execute Operation&lt;/b&gt;&lt;br&gt;Bulk index / search / k-NN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1200" y="400" width="300" height="40" as="geometry" />
        </mxCell>

        <mxCell id="server-serial" value="&lt;b&gt;Serialize Response&lt;/b&gt;&lt;br&gt;Result → Protobuf binary bytes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1200" y="455" width="300" height="40" as="geometry" />
        </mxCell>

        <mxCell id="server-send" value="&lt;b&gt;Send Response&lt;/b&gt;&lt;br&gt;Over same HTTP/2 connection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1200" y="510" width="300" height="40" as="geometry" />
        </mxCell>

        <!-- Server internal arrows -->
        <mxCell id="sa1" value="" style="endArrow=block;endSize=8;endFill=1;html=1;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1350" y="385" as="sourcePoint" /><mxPoint x="1350" y="400" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="sa2" value="" style="endArrow=block;endSize=8;endFill=1;html=1;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1350" y="440" as="sourcePoint" /><mxPoint x="1350" y="455" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="sa3" value="" style="endArrow=block;endSize=8;endFill=1;html=1;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1350" y="495" as="sourcePoint" /><mxPoint x="1350" y="510" as="targetPoint" /></mxGeometry></mxCell>

        <!-- ═══ CENTER: Network (HTTP/2) ═══ -->
        <!-- Request arrow -->
        <mxCell id="net-req" value="" style="endArrow=block;endSize=12;endFill=1;html=1;strokeWidth=3;strokeColor=#009900;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="440" y="440" as="sourcePoint" />
            <mxPoint x="1160" y="365" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="net-req-label" value="&lt;font color=&quot;#009900&quot; size=&quot;2&quot;&gt;&lt;b&gt;Request&lt;/b&gt;&lt;br&gt;Binary protobuf over HTTP/2&lt;br&gt;(compact, fast)&lt;/font&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="net-req">
          <mxGeometry x="0.1" relative="1" as="geometry"><mxPoint y="-25" as="offset" /></mxGeometry>
        </mxCell>

        <!-- Response arrow -->
        <mxCell id="net-resp" value="" style="endArrow=block;endSize=12;endFill=1;html=1;strokeWidth=3;strokeColor=#0066CC;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1160" y="530" as="sourcePoint" />
            <mxPoint x="440" y="530" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="net-resp-label" value="&lt;font color=&quot;#0066CC&quot; size=&quot;2&quot;&gt;&lt;b&gt;Response&lt;/b&gt;&lt;br&gt;Binary protobuf over HTTP/2&lt;br&gt;(same connection, no new handshake)&lt;/font&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="net-resp">
          <mxGeometry x="0.1" relative="1" as="geometry"><mxPoint y="25" as="offset" /></mxGeometry>
        </mxCell>

        <!-- ═══ BOTTOM: Key Properties ═══ -->
        <mxCell id="props-title" value="&lt;b&gt;Key Properties of gRPC&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="680" y="620" width="200" height="25" as="geometry" />
        </mxCell>

        <mxCell id="prop1" value="&lt;b&gt;Binary Serialization&lt;/b&gt;&lt;br&gt;Protobuf is ~40% smaller&lt;br&gt;than JSON text" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#43a047;align=center;" vertex="1" parent="1">
          <mxGeometry x="100" y="655" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="prop2" value="&lt;b&gt;HTTP/2&lt;/b&gt;&lt;br&gt;Multiplexed, persistent&lt;br&gt;connections (no handshake)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#43a047;align=center;" vertex="1" parent="1">
          <mxGeometry x="340" y="655" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="prop3" value="&lt;b&gt;Typed Contract&lt;/b&gt;&lt;br&gt;.proto file = shared schema&lt;br&gt;no mismatched fields" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#43a047;align=center;" vertex="1" parent="1">
          <mxGeometry x="580" y="655" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="prop4" value="&lt;b&gt;Language Agnostic&lt;/b&gt;&lt;br&gt;Client in Python, server in&lt;br&gt;Java — proto bridges both" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#43a047;align=center;" vertex="1" parent="1">
          <mxGeometry x="820" y="655" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="prop5" value="&lt;b&gt;Streaming Support&lt;/b&gt;&lt;br&gt;Client/server/bidirectional&lt;br&gt;streaming built-in" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#43a047;align=center;" vertex="1" parent="1">
          <mxGeometry x="1060" y="655" width="200" height="60" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
