<mxfile host="app.diagrams.net">
  <diagram name="Bulk Ingestion via gRPC Before New Changes" id="bulk-before">
    <mxGraphModel dx="1600" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="&lt;b&gt;&lt;font size=&quot;4&quot;&gt;Bulk Ingestion via gRPC — Before New Changes&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;What clients must do themselves to use gRPC today&lt;/i&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="500" y="20" width="450" height="50" as="geometry" />
        </mxCell>

        <!-- Step 1: Dependencies -->
        <mxCell id="step1" value="&lt;b&gt;&lt;font size=&quot;2&quot;&gt;Dependencies&lt;/font&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#43a047;arcSize=12;align=center;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="240" height="140" as="geometry" />
        </mxCell>
        <mxCell id="step1-detail" value="Must include compiled protobuf&lt;br&gt;libraries that provide schema&lt;br&gt;types for building requests and&lt;br&gt;understanding responses&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; size=&quot;1&quot;&gt;• opensearch-protobufs&lt;br&gt;• protobuf-java / grpcio&lt;br&gt;• io.grpc libraries&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="55" y="115" width="210" height="110" as="geometry" />
        </mxCell>

        <!-- Arrow 1→2 -->
        <mxCell id="a12" value="" style="endArrow=block;endSize=12;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="280" y="160" as="sourcePoint" />
            <mxPoint x="320" y="160" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Step 2: Channel Creation -->
        <mxCell id="step2" value="&lt;b&gt;&lt;font size=&quot;2&quot;&gt;Channel Creation&lt;/font&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#43a047;arcSize=12;align=center;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="320" y="90" width="240" height="140" as="geometry" />
        </mxCell>
        <mxCell id="step2-detail" value="Clients must create and manage&lt;br&gt;the gRPC channel (single&lt;br&gt;client-server connection)&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; size=&quot;1&quot;&gt;ManagedChannel channel =&lt;br&gt;  NettyChannelBuilder&lt;br&gt;    .forAddress(host, 9400)&lt;br&gt;    .build();&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="335" y="115" width="210" height="110" as="geometry" />
        </mxCell>

        <!-- Arrow 2→3 -->
        <mxCell id="a23" value="" style="endArrow=block;endSize=12;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="560" y="160" as="sourcePoint" />
            <mxPoint x="600" y="160" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Step 3: Security Protocol -->
        <mxCell id="step3" value="&lt;b&gt;&lt;font size=&quot;2&quot;&gt;Security Protocol&lt;br&gt;(TLS, Basic Auth, JWT)&lt;/font&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#43a047;arcSize=12;align=center;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="600" y="90" width="240" height="140" as="geometry" />
        </mxCell>
        <mxCell id="step3-detail" value="Client must configure all auth&lt;br&gt;headers and TLS on the channel&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; size=&quot;1&quot;&gt;• Basic Auth headers&lt;br&gt;• JWT token refresh&lt;br&gt;• IAM SigV4 signing&lt;br&gt;• TLS / mTLS certificates&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;Applied per-channel manually&lt;/i&gt;" style="text;html=1;align=center;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="615" y="120" width="210" height="105" as="geometry" />
        </mxCell>

        <!-- Arrow 3→4 -->
        <mxCell id="a34" value="" style="endArrow=block;endSize=12;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="840" y="160" as="sourcePoint" />
            <mxPoint x="880" y="160" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Step 4: Connection Management -->
        <mxCell id="step4" value="&lt;b&gt;&lt;font size=&quot;2&quot;&gt;Connection&lt;br&gt;Management&lt;/font&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#43a047;arcSize=12;align=center;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="880" y="90" width="240" height="140" as="geometry" />
        </mxCell>
        <mxCell id="step4-detail" value="Clients must manage the&lt;br&gt;connection lifecycle themselves&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; size=&quot;1&quot;&gt;• Keep-alive &amp; health checks&lt;br&gt;• Reconnect on failure&lt;br&gt;• Graceful shutdown&lt;br&gt;• Error handling / retries&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;No built-in monitoring&lt;/i&gt;" style="text;html=1;align=center;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="895" y="120" width="210" height="105" as="geometry" />
        </mxCell>

        <!-- Arrow 4→5 -->
        <mxCell id="a45" value="" style="endArrow=block;endSize=12;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1120" y="160" as="sourcePoint" />
            <mxPoint x="1160" y="160" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Step 5: Send Protobuf Request -->
        <mxCell id="step5" value="&lt;b&gt;&lt;font size=&quot;2&quot;&gt;Send Protobuf&lt;br&gt;Request / Response&lt;/font&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#43a047;arcSize=12;align=center;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1160" y="90" width="240" height="140" as="geometry" />
        </mxCell>
        <mxCell id="step5-detail" value="Use stub to send/receive&lt;br&gt;protobuf messages directly&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; size=&quot;1&quot;&gt;stub = DocumentService&lt;br&gt;  .newBlockingStub(channel)&lt;br&gt;resp = stub.bulk(protoReq)&lt;br&gt;&lt;br&gt;// Parse protobuf response&lt;br&gt;resp.getItems(0).getResult()&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1175" y="120" width="210" height="105" as="geometry" />
        </mxCell>

        <!-- Arrow 5→Server -->
        <mxCell id="a5s" value="" style="endArrow=block;endSize=12;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1400" y="160" as="sourcePoint" />
            <mxPoint x="1440" y="160" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Server -->
        <mxCell id="server" value="&lt;b&gt;&lt;font size=&quot;2&quot;&gt;OpenSearch&lt;br&gt;Server :9400&lt;/font&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcdd2;strokeColor=#e53935;arcSize=12;align=center;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1440" y="100" width="140" height="120" as="geometry" />
        </mxCell>
        <mxCell id="server-detail" value="gRPC endpoint&lt;br&gt;&lt;br&gt;Decode protobuf&lt;br&gt;Execute bulk&lt;br&gt;Return protobuf" style="text;html=1;align=center;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1450" y="135" width="120" height="80" as="geometry" />
        </mxCell>

        <!-- Bottom banner -->
        <mxCell id="banner" value="&lt;font color=&quot;#CC0000&quot; size=&quot;2&quot;&gt;&lt;b&gt;⚠ Client must rewrite their entire client-side code:&lt;/b&gt; different syntax, different transport libraries, different API representations.&lt;br&gt;No fallback to REST for unsupported operations — need a separate REST client for search, info, etc.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#e53935;arcSize=5;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="270" width="1540" height="60" as="geometry" />
        </mxCell>

        <!-- "Client Responsibility" bracket -->
        <mxCell id="bracket" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;flipH=0;size=0.5;strokeColor=#FF6600;strokeWidth=2;rotation=-90;" vertex="1" parent="1">
          <mxGeometry x="640" y="-10" width="20" height="1380" as="geometry" />
        </mxCell>
        <mxCell id="bracket-label" value="&lt;font color=&quot;#FF6600&quot; size=&quot;2&quot;&gt;&lt;b&gt;ALL CLIENT'S RESPONSIBILITY&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="560" y="245" width="260" height="25" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
