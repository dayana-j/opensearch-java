<mxfile host="app.diagrams.net">
  <diagram name="Before - Manual gRPC (No Transparent Support)" id="before-grpc">
    <mxGraphModel dx="1416" dy="921" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=16;" value="&lt;b&gt;Before: Using gRPC Without Transparent Support (Client Must Do Everything)&lt;/b&gt;" vertex="1">
          <mxGeometry height="30" width="600" x="400" y="15" as="geometry" />
        </mxCell>
        <mxCell id="step1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=10;align=center;verticalAlign=top;spacingTop=5;" value="&lt;b&gt;1. Include Protobuf&lt;br&gt;Libraries&lt;/b&gt;&lt;hr&gt;&lt;font size=&quot;1&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;font face=&quot;Courier New&quot; size=&quot;1&quot;&gt;opensearch-protobufs&lt;br&gt;protobuf-java&lt;br&gt;grpcio / grpcio-tools&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;Schema types for&lt;br&gt;requests &amp; responses&lt;/i&gt;" vertex="1">
          <mxGeometry height="160" width="180" x="40" y="70" as="geometry" />
        </mxCell>
        <mxCell id="a12" edge="1" parent="1" source="step1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;containSize=1;strokeWidth=2;" target="step2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="step2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=10;align=center;verticalAlign=top;spacingTop=5;" value="&lt;b&gt;2. Rewrite Requests&lt;br&gt;in Protobuf Syntax&lt;/b&gt;&lt;hr&gt;&lt;font size=&quot;1&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;font face=&quot;Courier New&quot; size=&quot;1&quot;&gt;BulkRequest.newBuilder()&lt;br&gt;  .addOperations(...)&lt;br&gt;  .setDocument(&lt;br&gt;    Struct.newBuilder()&lt;br&gt;      .putFields(...)&lt;br&gt;  .build()&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;❌ Not JSON anymore&lt;br&gt;❌ Different API types&lt;/i&gt;" vertex="1">
          <mxGeometry height="160" width="200" x="270" y="70" as="geometry" />
        </mxCell>
        <mxCell id="a23" edge="1" parent="1" source="step2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;containSize=1;strokeWidth=2;" target="step3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="step3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=10;align=center;verticalAlign=top;spacingTop=5;" value="&lt;b&gt;&lt;font face=&quot;Helvetica&quot;&gt;3. Create &amp;amp; Manage&lt;br&gt;gRPC Channel&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;font face=&quot;Helvetica&quot;&gt;&lt;font size=&quot;1&quot; style=&quot;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;font size=&quot;1&quot; style=&quot;&quot;&gt;ManagedChannel channel =&lt;br&gt;  NettyChannelBuilder&lt;br&gt;    .forAddress(host,9400)&lt;br&gt;    .build();&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;i style=&quot;&quot;&gt;Connection lifecycle&lt;br&gt;Reconnect on failure&lt;br&gt;Shutdown handling&lt;/i&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="160" width="200" x="520" y="70" as="geometry" />
        </mxCell>
        <mxCell id="a34" edge="1" parent="1" source="step3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;containSize=1;strokeWidth=2;" target="step4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="step4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=10;align=center;verticalAlign=top;spacingTop=5;" value="&lt;b&gt;4. Configure Auth&lt;br&gt;&amp; TLS Manually&lt;/b&gt;&lt;hr&gt;&lt;font size=&quot;1&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;font face=&quot;Courier New&quot; size=&quot;1&quot;&gt;// Attach to channel:&lt;br&gt;• Basic Auth headers&lt;br&gt;• JWT token refresh&lt;br&gt;• IAM SigV4 signing&lt;br&gt;• TLS certificates&lt;br&gt;• mTLS client certs&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;All applied per-channel&lt;/i&gt;" vertex="1">
          <mxGeometry height="160" width="180" x="770" y="70" as="geometry" />
        </mxCell>
        <mxCell id="a45" edge="1" parent="1" source="step4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;containSize=1;strokeWidth=2;" target="step5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="step5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=10;align=center;verticalAlign=top;spacingTop=5;" value="&lt;b&gt;5. Send Request &amp;&lt;br&gt;Parse Protobuf Response&lt;/b&gt;&lt;hr&gt;&lt;font size=&quot;1&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;font face=&quot;Courier New&quot; size=&quot;1&quot;&gt;stub = DocumentService&lt;br&gt;  .newBlockingStub(ch);&lt;br&gt;BulkResponse resp =&lt;br&gt;  stub.bulk(protoReq);&lt;br&gt;&lt;br&gt;// Read protobuf fields&lt;br&gt;resp.getItems(0)&lt;br&gt;  .getResult()&lt;/font&gt;" vertex="1">
          <mxGeometry height="160" width="200" x="1000" y="70" as="geometry" />
        </mxCell>
        <mxCell id="a56" edge="1" parent="1" source="step5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;containSize=1;strokeWidth=2;" target="step6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="step6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=10;align=center;verticalAlign=top;spacingTop=5;" value="&lt;b&gt;6. OpenSearch&lt;br&gt;Server&lt;/b&gt;&lt;hr&gt;&lt;font size=&quot;1&quot;&gt;&lt;br&gt;&lt;/font&gt;gRPC endpoint&lt;br&gt;&lt;b&gt;port 9400&lt;/b&gt;&lt;br&gt;&lt;br&gt;Decode protobuf&lt;br&gt;Execute operation&lt;br&gt;Return protobuf" vertex="1">
          <mxGeometry height="160" width="170" x="1250" y="70" as="geometry" />
        </mxCell>
        <mxCell id="no-fallback" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEEEE;strokeColor=#CC0000;arcSize=10;align=center;verticalAlign=middle;dashed=1;" value="&lt;font color=&quot;#CC0000&quot;&gt;&lt;b&gt;❌ No REST Fallback&lt;/b&gt;&lt;br&gt;&lt;br&gt;If you also need search, info,&lt;br&gt;or other non-bulk operations:&lt;br&gt;&lt;b&gt;maintain a separate REST client entirely&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="90" width="310" x="545" y="300" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
